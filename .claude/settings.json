{
  "mcpServers": {
    "evidence-mcp": {
      "command": "evidence-mcp",
      "args": []
    }
  },
  "permissions": {
    "deny": [
      "evidence/**"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cargo evidence gate --format=jsonl"
          }
        ]
      }
    ]
  }
}
