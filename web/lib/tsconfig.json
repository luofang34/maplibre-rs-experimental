{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist/",
    "strict": false,
    "module": "es2022",
    "target": "es2022",
    "lib": [ "es6", "dom" ],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "allowJs": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": ["maplibre", "env"],
    "typeRoots": ["./@types"]
  },
  "include": ["./src/**/*"]
}
