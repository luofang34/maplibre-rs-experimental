// How the ground turns from day to night under the host's sun, shared by terrain and by the
// globe drawn without terrain so that both turn alike. `twilight` holds the sines of the band's
// two elevations, the night side's share of the day's light and the share of the sun an eclipse
// leaves; `moonlight` the moon's direction and the light it adds overhead.

// The night side turns a little toward blue.
const NIGHT_TINT: vec3<f32> = vec3<f32>(0.85, 0.93, 1.1);

// How much of its day colour a surface with `normal` shows, and the light it keeps at night,
// raised by a moon above its horizon by the moon's lit share. A smooth ramp crosses the band,
// and an eclipse takes the day toward the night as the moon covers the sun, its share of the
// light shown through the display's gamma.
fn daylight_weights(
    normal: vec3<f32>,
    sun: vec3<f32>,
    twilight: vec4<f32>,
    moonlight: vec4<f32>,
) -> vec2<f32> {
    let day = smoothstep(twilight.x, twilight.y, dot(normal, sun));
    let moon_elevation_sine = max(dot(normal, moonlight.xyz), 0.0);
    let night_level = twilight.z + moonlight.w * moon_elevation_sine;
    let sunlit = pow(twilight.w, 1.0 / 2.2);
    return vec2<f32>(day * sunlit, night_level);
}
